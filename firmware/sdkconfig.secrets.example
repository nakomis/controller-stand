# Copy to sdkconfig.secrets (never committed) and fill in. Used only when the prov partition holds no
# network (a board not yet provisioned). Add it with
#   idf.py -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.secrets" reconfigure
# and delete sdkconfig first, because an existing sdkconfig wins over defaults.
CONFIG_GROGU_WIFI_SSID="your-ssid"
CONFIG_GROGU_WIFI_PASSWORD="your-password"
